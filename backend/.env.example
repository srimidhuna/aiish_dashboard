# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in values before running locally.
# Never commit .env — only .env.example is committed.

# Full PostgreSQL connection string
# When running locally with docker-compose, host is 'postgres' (service name)
# When running backend outside Docker, host is 'localhost'
DATABASE_URL=postgresql://aiish_user:aiish_secret@localhost:5432/aiish_db

# JWT signing secret — must be long, random, and kept secret in production
JWT_SECRET=change_me_to_a_long_random_string_in_production

# JWT token expiry (e.g. 8h, 1d, 30m)
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS — no trailing slash, no wildcard
# The frontend (Prompt 1B) must send withCredentials:true to receive cookies
FRONTEND_ORIGIN=http://localhost:3000

# Environment: 'development' | 'production'
# production → disables Swagger UI, enables Secure cookie flag
NODE_ENV=development

# Port the backend server listens on
PORT=3001
