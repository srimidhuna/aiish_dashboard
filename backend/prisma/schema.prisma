generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model State {
  id        String     @id @default(uuid())
  name      String     @unique
  districts District[]

  @@map("states")
}

model District {
  id        String     @id @default(uuid())
  name      String
  stateId   String     @map("state_id")
  babies    Baby[]
  state     State      @relation(fields: [stateId], references: [id])
  hospitals Hospital[]

  @@unique([name, stateId])
  @@map("districts")
}

model Hospital {
  id                   String         @id @default(uuid())
  name                 String
  districtId           String         @map("district_id")
  address              String?
  contactPerson        String?        @map("contact_person")
  contactPhone         String?        @map("contact_phone")
  primaryAudiologistId String?        @map("primary_audiologist_id")
  status               HospitalStatus @default(active)
  babies               Baby[]
  district             District       @relation(fields: [districtId], references: [id])
  primaryAudiologist   User?          @relation("HospitalPrimaryAudiologist", fields: [primaryAudiologistId], references: [id])
  users                User[]

  @@map("hospitals")
}

model User {
  id                            String            @id @default(uuid())
  email                         String            @unique
  passwordHash                  String            @map("password_hash")
  fullName                      String            @map("full_name")
  hospitalId                    String            @map("hospital_id")
  role                          UserRole          @default(audiologist)
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  deletedAt                     DateTime?         @map("deleted_at")
  auditLogs                     AuditLog[]
  babiesCreated                 Baby[]            @relation("BabyCreatedBy")
  babiesDeleted                 Baby[]            @relation("BabyDeletedBy")
  followUpsProvided             FollowUp[]        @relation("FollowUpProvider")
  hospitalsAsPrimaryAudiologist Hospital[]        @relation("HospitalPrimaryAudiologist")
  timelines                     PatientTimeline[]
  screeningsAssigned            Screening[]       @relation("ScreeningAssignedAudiologist")
  screenings                    Screening[]       @relation("ScreeningTestedBy")
  hospital                      Hospital          @relation(fields: [hospitalId], references: [id])

  @@map("users")
}

model Staff {
  id                String    @id @default(uuid())
  employeeId        String    @unique @map("employee_id")
  fullName          String    @map("full_name")
  gender            String
  dateOfBirth       DateTime? @map("date_of_birth")
  mobileNumber      String?   @map("mobile_number")
  email             String?
  photoUrl          String?   @map("photo_url")
  hospitalId        String?   @map("hospital_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  department        String?
  designation       String?
  licenseNumber     String?   @map("license_number")
  qualification     String?
  role              String?
  yearsOfExperience Int?      @map("years_of_experience")
  status            String    @default("active")
  address           String?

  @@map("staff")
}

model RiskCategory {
  id              String           @id @default(uuid())
  label           String           @unique
  categoryGroup   CategoryGroup    @map("category_group")
  sortOrder       Int              @default(0) @map("sort_order")
  babyRiskFactors BabyRiskFactor[]

  @@map("risk_categories")
}

model RecommendationType {
  id                  String               @id @default(uuid())
  label               String               @unique
  babyRecommendations BabyRecommendation[]

  @@map("recommendation_types")
}

model Baby {
  id                       String                 @id @default(uuid())
  mrNumber                 String?                @map("mr_number")
  pocdNumber               String?                @map("pocd_number")
  uniqueMotherId           String?                @map("unique_mother_id")
  dob                      DateTime
  gender                   String
  motherName               String                 @map("mother_name")
  fatherName               String?                @map("father_name")
  address                  String?
  taluk                    String?
  districtId               String                 @map("district_id")
  hospitalId               String                 @map("hospital_id")
  phone1                   String?                @map("phone_1")
  phone2                   String?                @map("phone_2")
  nbsCentre                String?                @map("nbs_centre")
  region                   Region?
  deliveryType             DeliveryType?          @map("delivery_type")
  noOfSiblings             Int?                   @map("no_of_siblings")
  /// Case workflow status — deliberately separate from Screening.overall_result
  status                   BabyStatus             @default(draft)
  createdById              String                 @map("created_by")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  deletedAt                DateTime?              @map("deleted_at")
  deletedById              String?                @map("deleted_by")
  parentDistrict           String?                @map("parent_district")
  parentState              String?                @map("parent_state")
  birthWeightGrams         Int?                   @map("birth_weight_grams")
  department               String?                @map("department")
  doctorName               String?                @map("doctor_name")
  email                    String?
  firstName                String?                @map("first_name")
  gestationalAgeWeeks      Int?                   @map("gestational_age_weeks")
  lastName                 String?                @map("last_name")
  pinCode                  String?                @map("pin_code")
  placeOfBirth             String?                @map("place_of_birth")
  referredByOther          String?                @map("referred_by_other")
  remarks                  String?
  timeOfBirth              String?                @map("time_of_birth")
  referredBy               ReferredBy?            @map("referred_by")
  educationLevel           EducationLevelParent?  @map("education_level")
  educationLevelOther      String?                @map("education_level_other")
  religion                 Religion?
  religionOther            String?                @map("religion_other")
  socioEconomicStatus      SocioEconomicStatus?   @map("socio_economic_status")
  assessingStaffId         String?                @map("assessing_staff_id")
  assessingStaffEmployeeId String?                @map("assessing_staff_employee_id")
  assessingStaffName       String?                @map("assessing_staff_name")
  whatsappNumber           String?                @map("whatsapp_number")
  assessment               AudiologistAssessment?
  createdBy                User                   @relation("BabyCreatedBy", fields: [createdById], references: [id])
  deletedBy                User?                  @relation("BabyDeletedBy", fields: [deletedById], references: [id])
  district                 District               @relation(fields: [districtId], references: [id])
  hospital                 Hospital               @relation(fields: [hospitalId], references: [id])
  riskFactors              BabyRiskFactor[]
  followUps                FollowUp[]
  timelines                PatientTimeline[]
  screenings               Screening[]

  @@index([deletedAt, createdAt])
  @@index([districtId])
  @@index([hospitalId])
  @@map("babies")
}

model BabyRiskFactor {
  id             String       @id @default(uuid())
  babyId         String       @map("baby_id")
  riskCategoryId String       @map("risk_category_id")
  baby           Baby         @relation(fields: [babyId], references: [id])
  riskCategory   RiskCategory @relation(fields: [riskCategoryId], references: [id])

  @@unique([babyId, riskCategoryId])
  @@map("baby_risk_factors")
}

model AudiologistAssessment {
  id                       String               @id @default(uuid())
  babyId                   String               @unique @map("baby_id")
  familyHistoryHearingLoss Boolean              @default(false) @map("family_history_hearing_loss")
  consanguinityDegree      ConsanguinityDegree? @map("consanguinity_degree")
  caregiverConcern         Boolean              @default(false) @map("caregiver_concern")
  reflexMoro               ReflexResult?        @map("reflex_moro")
  reflexRooting            ReflexResult?        @map("reflex_rooting")
  reflexBabinski           ReflexResult?        @map("reflex_babinski")
  reflexPalmar             ReflexResult?        @map("reflex_palmar")
  reflexPlantar            ReflexResult?        @map("reflex_plantar")
  baby                     Baby                 @relation(fields: [babyId], references: [id])

  @@map("audiologist_assessments")
}

model Screening {
  id                    String               @id @default(uuid())
  babyId                String               @map("baby_id")
  entFindings           String?              @map("ent_findings")
  teoaeRight            ScreeningTestResult? @map("teoae_right")
  teoaeLeft             ScreeningTestResult? @map("teoae_left")
  dpoaeRight            ScreeningTestResult? @map("dpoae_right")
  dpoaeLeft             ScreeningTestResult? @map("dpoae_left")
  aabr1Right            ScreeningTestResult? @map("aabr1_right")
  aabr1Left             ScreeningTestResult? @map("aabr1_left")
  aabr2Right            ScreeningTestResult? @map("aabr2_right")
  aabr2Left             ScreeningTestResult? @map("aabr2_left")
  /// Outcome of this screening visit — separate from Baby.status (case workflow)
  overallResult         PassReferResult?     @map("overall_result")
  remarks               String?
  testedById            String               @map("tested_by")
  testedAt              DateTime             @map("tested_at")
  assignedAudiologistId String?              @map("assigned_audiologist_id")
  dueDate               DateTime?            @map("due_date")
  /// Workflow status of this screening record — separate from overallResult (the outcome)
  status                ScreeningStatus      @default(draft)
  boaResult             ScreeningTestResult? @map("boa_result")
  type                  ScreeningType        @default(initial)
  assignedAudiologist   User?                @relation("ScreeningAssignedAudiologist", fields: [assignedAudiologistId], references: [id])
  baby                  Baby                 @relation(fields: [babyId], references: [id])
  testedBy              User                 @relation("ScreeningTestedBy", fields: [testedById], references: [id])

  @@index([babyId])
  @@index([testedAt])
  @@index([status])
  @@map("screenings")
}

model FollowUp {
  id                        String               @id @default(uuid())
  babyId                    String               @map("baby_id")
  followUpType              FollowUpType         @map("follow_up_type")
  provisionalDiagnosisRight String?              @map("provisional_diagnosis_right")
  provisionalDiagnosisLeft  String?              @map("provisional_diagnosis_left")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  actualDate                DateTime?            @map("actual_date")
  nextSteps                 String?              @map("next_steps")
  notes                     String?
  providerId                String               @map("provider_id")
  scheduledDate             DateTime             @map("scheduled_date")
  status                    FollowUpStatus       @default(scheduled)
  recommendations           BabyRecommendation[]
  baby                      Baby                 @relation(fields: [babyId], references: [id])
  provider                  User                 @relation("FollowUpProvider", fields: [providerId], references: [id])

  @@index([babyId])
  @@index([scheduledDate])
  @@index([status])
  @@map("follow_ups")
}

model BabyRecommendation {
  id                   String             @id @default(uuid())
  followUpId           String             @map("follow_up_id")
  recommendationTypeId String             @map("recommendation_type_id")
  followUp             FollowUp           @relation(fields: [followUpId], references: [id])
  recommendationType   RecommendationType @relation(fields: [recommendationTypeId], references: [id])

  @@unique([followUpId, recommendationTypeId])
  @@map("baby_recommendations")
}

model PatientTimeline {
  id          String        @id @default(uuid())
  babyId      String        @map("baby_id")
  event       TimelineEvent
  description String?
  createdById String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  baby        Baby          @relation(fields: [babyId], references: [id])
  createdBy   User          @relation(fields: [createdById], references: [id])

  @@map("patient_timelines")
}

model AuditLog {
  id          String   @id @default(uuid())
  tableName   String   @map("table_name")
  recordId    String   @map("record_id")
  changedById String   @map("changed_by")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  changedAt   DateTime @default(now()) @map("changed_at")
  changedBy   User     @relation(fields: [changedById], references: [id])

  @@map("audit_logs")
}

enum UserRole {
  audiologist
  admin
  doctor
}

/// Workflow state of a Baby case — separate from Screening.overall_result
enum BabyStatus {
  draft
  completed
  follow_up_required
  under_evaluation
  under_treatment
  closed
}

/// Used for TEOAE, DPOAE, AABR fields in Screening
enum ScreeningTestResult {
  pass
  refer
  noisy
  cnt
  not_done
}

/// Used for Screening.overall_result and Screening.boa_result (pass/refer only)
enum PassReferResult {
  pass
  refer
}

/// Used for AudiologistAssessment reflex fields
enum ReflexResult {
  normal
  abnormal
}

/// Degree of consanguinity in AudiologistAssessment
enum ConsanguinityDegree {
  first
  second
  third
}

/// Follow-up contact/visit type
enum FollowUpType {
  phone
  regular
  not_applicable
}

/// Geographic classification of baby's address
enum Region {
  urban
  rural
}

/// Mode of delivery
enum DeliveryType {
  normal
  caesarean
  breech
  home
}

/// Referral source at time of NBS registration
enum ReferredBy {
  pocd_staff
  doctor
  self
  others
}

/// BPL/AAY/APL classification
enum SocioEconomicStatus {
  aay
  bpl
  apl
}

/// Parental education level
enum EducationLevelParent {
  illiterate
  primary
  high_school
  graduate_and_above
  others
}

/// Family religion
enum Religion {
  hindu
  muslim
  christian
  others
}

/// Hospital directory status
enum HospitalStatus {
  active
  inactive
}

/// Workflow status of a single Screening record (draft in progress, scheduled/due, completed)
enum ScreeningStatus {
  draft
  scheduled
  completed
}

/// Type of screening (initial or rescreening)
enum ScreeningType {
  initial
  rescreening
}

/// Workflow status of a FollowUp
enum FollowUpStatus {
  scheduled
  completed
  missed
  lost_to_followup
  rescheduled
}

/// Risk category grouping for RiskCategory master table
enum CategoryGroup {
  perinatal
  postnatal
  family_history
  other
}

/// Events recorded in PatientTimeline
enum TimelineEvent {
  registered
  screened
  follow_up_created
  treatment_started
  closed
  other
}
