# ─── PostgreSQL (used by docker-compose postgres service) ─────────────────────
POSTGRES_USER=aiish_user
POSTGRES_PASSWORD=aiish_secret
POSTGRES_DB=aiish_db

# ─── Backend ──────────────────────────────────────────────────────────────────
# Full Prisma connection string (must match POSTGRES_* values above)
DATABASE_URL=postgresql://aiish_user:aiish_secret@postgres:5432/aiish_db

# JWT signing secret — change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_string_in_production

# How long access tokens are valid (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# Origin of the frontend app — no trailing slash, no wildcard
# Used for CORS allow-origin; backend sends cookies only to this origin
FRONTEND_ORIGIN=http://localhost:3000

# Application environment — set to 'production' in prod (disables Swagger, enables Secure cookies)
NODE_ENV=development

# Port the backend listens on inside Docker (mapped to host in docker-compose)
PORT=3001

# ─── Frontend ───────────────────────────────────────────────────────────────────
# Must be browser-accessible (localhost), NOT the Docker service name —
# the frontend is a client-side SPA that runs API calls from the user's browser.
VITE_API_URL=http://localhost:3001
